{
  "layer": "top",
  "position": "bottom",
  "height": 24,
  "margin-bottom": 0,
  "spacing": 0,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["custom/tag"],
  "modules-right": [
    "custom/cpu-graph",
    "custom/mem-graph",
    "custom/temp-graph",
    "custom/net-graph",
    "custom/disk-alert",
    "backlight",
    "battery",
    "pulseaudio",
    "custom/capslock",
    "tray",
    "clock",
    "custom/power",
  ],

  "hyprland/workspaces": {
    "disable-scroll": true,
    // Each bar shows only the workspaces on its own monitor.
    "all-outputs": false,
    // Leading zeros are added here; the workspace name remains "1".
    "format": "{icon}",
    "format-icons": {
      "1": "01",
      "2": "02",
      "3": "03",
      "4": "04",
      "5": "05",
      "6": "06",
      "7": "07",
      "8": "08",
      "9": "09",
      "10": "10",
      "default": "··",
      "urgent": "!!",
    },
    // Monitor names are specific to this machine; adjust or remove this block on another machine.
    "persistent-workspaces": {
      "DP-1": [1, 2, 3, 4, 5],
      "HDMI-A-2": [6, 7, 8, 9, 10],
    },
  },
  // Label: 改善 (kaizen) = continuous improvement. Customize the text as desired.
  "custom/tag": {
    "exec": "echo [[ 改善 ]]",
    "interval": "once",
    "tooltip": false,
  },
  // The three graphs are persistent processes: they print every 2s, with no fork per tick.
  "custom/cpu-graph": {
    "exec": "$HOME/.local/bin/cpu-graph",
    "return-type": "json",
    "restart-interval": 5,
  },
  "custom/mem-graph": {
    "exec": "$HOME/.local/bin/mem-graph",
    "return-type": "json",
    "restart-interval": 5,
  },
  // Hidden while disk usage is normal; appears at 80% or higher.
  "custom/disk-alert": {
    "exec": "$HOME/.local/bin/disk-alert",
    "return-type": "json",
    "interval": 300,
  },
  "custom/temp-graph": {
    "exec": "$HOME/.local/bin/temp-graph",
    "return-type": "json",
    "restart-interval": 5,
  },
  // Signal icon; click to open floating nmtui and manage networks.
  "custom/net-graph": {
    "exec": "$HOME/.local/bin/net-graph",
    "return-type": "json",
    "restart-interval": 5,
    "on-click": "$HOME/.local/bin/network-menu",
  },
  "backlight": {
    "format": "󰃠",
    "tooltip-format": "Brightness: {percent}%",
    "on-click": "$HOME/.local/bin/brightness-control up",
    "on-click-right": "$HOME/.local/bin/brightness-control down",
    "on-scroll-up": "$HOME/.local/bin/brightness-control up",
    "on-scroll-down": "$HOME/.local/bin/brightness-control down",
  },
  "battery": {
    "interval": 9,
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-full": "󰁹 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "states": { "warning": 30, "critical": 15 },
    "tooltip-format": "Battery: {capacity}%\n{time}",
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 ",
    "format-icons": { "default": [" ", " ", "  "] },
    "tooltip-format": "Volume: {volume}%\nClick to mute",
    "on-click": "$HOME/.local/bin/volume-control mute",
    "on-scroll-up": "$HOME/.local/bin/volume-control up",
    "on-scroll-down": "$HOME/.local/bin/volume-control down",
  },
  "custom/capslock": {
    "exec": "$HOME/.config/waybar/capslock.sh",
    "return-type": "json",
    "restart-interval": 5,
    "tooltip": false,
  },
  "tray": {
    "icon-size": 13,
    "spacing": 5,
  },
  "clock": {
    "locale": "C",
    "interval": 1,
    "format": "{:%H:%M}",
    "format-alt": "{:%d/%m  %H:%M:%S}",
    "tooltip-format": "<big>{:%A, %d %B}</big>\n<tt><small>{calendar}</small></tt>",
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "$HOME/.local/bin/power-menu",
  },
}
