#!/usr/bin/env bash
set -euo pipefail

choice="$(printf '%s\n' \
  '󰌾  Lock' \
  '󰒲  Suspender' \
  '󰤄  Hibernar' \
  '󰜉  Reiniciar' \
  '󰐥  Desligar' \
  '󰍃  Log out' |
  rofi -dmenu -i -p 'Session')"

[[ -n "$choice" ]] || exit 0

confirm() {
  printf 'No\nYes\n' | rofi -dmenu -i -p "$1" | grep -qx 'Yes'
}

case "$choice" in
  *Lock)             exec "$HOME/.local/bin/lockscreen" ;;
  *Suspender)        systemctl suspend ;;
  *Hibernar)         confirm 'Hibernar agora?' && systemctl hibernate ;;
  *Reiniciar)        confirm 'Reiniciar agora?' && systemctl reboot ;;
  *Desligar)         confirm 'Desligar agora?' && systemctl poweroff ;;
  *'Log out')          confirm 'Exit Hyprland?' && hyprctl dispatch exit ;;
esac
