#!/usr/bin/env bash
set -euo pipefail

choice="$(printf '%s\n' \
  '󰌾  Lock' \
  '󰒲  Suspend' \
  '󰤄  Hibernate' \
  '󰜉  Restart' \
  '󰐥  Poweroff' \
  '󰍃  Log out' |
  rofi -dmenu -i -p 'Session')"

[[ -n "$choice" ]] || exit 0

confirm() {
  printf 'No\nYes\n' | rofi -dmenu -i -p "$1" | grep -qx 'Yes'
}

case "$choice" in
  *Lock)             exec "$HOME/.local/bin/lockscreen" ;;
  *Suspend)        systemctl suspend ;;
  *Hibernate)         confirm 'Hibernate now?' && systemctl hibernate ;;
  *Restart)        confirm 'Reboot now?' && systemctl reboot ;;
  *Poweroff)         confirm 'Power off now?' && systemctl poweroff ;;
  *'Log out')          confirm 'Exit Hyprland?' && hyprctl dispatch exit ;;
esac
