{
  // ======================================================
  // EDITOR — Font, typography, and basic behavior
  // ======================================================
  // Monospaced font with ligatures for extended reading
  "editor.fontFamily": "JetBrainsMono Nerd Font",
  "editor.fontLigatures": true,
  // Comfortable size and spacing for prolonged focus
  "editor.fontSize": 15,
  "editor.lineHeight": 1.6,
  // Solid cursor without animation (less visual stimulation)
  "editor.cursorBlinking": "solid",
  "editor.cursorSmoothCaretAnimation": "off",
  // Show trailing whitespace only (useful in Python)
  "editor.renderWhitespace": "trailing",
  // Remove unnecessary visual elements
  "editor.minimap.enabled": false,
  "editor.guides.indentation": false,
  // Subtle matching-pair highlight (useful without distraction)
  "editor.matchBrackets": "near",
  // ======================================================
  // VISUAL FOCUS — Reduced cognitive noise
  // ======================================================
  // Subtly highlight the current line
  "editor.renderLineHighlight": "line",
  "editor.lineHighlightBackground": "#101010",
  // Avoid multiple simultaneous highlights
  "editor.selectionHighlight": false,
  "editor.occurrencesHighlight": "off",
  // Slower, more predictable hover
  "editor.hover.delay": 600,
  "editor.hover.enabled": "on",
  // Disable smooth scrolling (fewer animations)
  "editor.smoothScrolling": false,
  "workbench.list.smoothScrolling": false,
  // Remove intrusive indicators
  "editor.lightbulb.enabled": "off",
  "editor.parameterHints.enabled": false,
  "editor.codeLens": false,
  // ======================================================
  // PYTHON — Less aggressive static analysis
  // ======================================================
  // Avoid constant red underlines
  // More predictable autocomplete
  "editor.suggestOnTriggerCharacters": true,
  "editor.tabCompletion": "on",
  // ======================================================
  // JUPYTER — Cell usage (# %%)
  // ======================================================
  // Cleaner interface for exploration
  "jupyter.showVariableView": false,
  "jupyter.showCellStatusBar": "hover",
  // Limit long outputs
  "jupyter.output.textLineLimit": 50,
  // Avoid unnecessary prompts
  "jupyter.askForKernelRestart": false,
  // ======================================================
  // EXPLORER AND SEARCH — Hide structural noise
  // ======================================================
  // Keep .venv visible in Explorer (optional)
  "files.exclude": {
    "**/.venv": false,
    "**/__pycache__": true,
    "**/.ipynb_checkpoints": true,
  },
  // Never search generated artifacts
  "search.exclude": {
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.ipynb_checkpoints": true,
  },
  // ======================================================
  // PRIVACY AND TELEMETRY
  // ======================================================
  "telemetry.telemetryLevel": "off",
  "telemetry.feedback.enabled": false,
  "redhat.telemetry.enabled": false,
  // ======================================================
  // SCROLLBARS — Remove visual clutter
  // ======================================================
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.horizontal": "hidden",
  // ======================================================
  // AUTOSAVE — Continuous workflow
  // ======================================================
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  // ======================================================
  // SUGGESTIONS — Less aggressive
  // ======================================================
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": true,
  },
  "editor.quickSuggestionsDelay": 300,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.acceptSuggestionOnEnter": "smart",
  "editor.suggestSelection": "first",
  "editor.inlineSuggest.enabled": false,
  // ======================================================
  // FORMATTING — Explicit control
  // ======================================================
  // Format on save without forcing a global formatter
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  // Use manual formatting for Python (Black via CLI)
  "[python]": {
    "editor.formatOnSave": false,
  },
  // ======================================================
  // GIT — Quiet behavior
  // ======================================================
  "git.autofetch": true,
  "git.confirmSync": false,
  // ======================================================
  // UI — Minimal interface
  // ======================================================
  "breadcrumbs.enabled": false,
  //"workbench.activityBar.location": "hidden",
  //"workbench.startupEditor": "none",
  // Remove the command center and visual menus
  "window.commandCenter": false,
  "window.menuBarVisibility": "hidden",
  "window.titleBarStyle": "native",
  // ======================================================
  // THEME — Low visual stimulation
  // ======================================================
  //"workbench.colorCustomizations": {
  //  "editor.background": "#080808",
  //  "sideBar.background": "#080808",
  //  "sideBar.foreground": "#cfcfcf",
  //  "sideBar.border": "#080808",
  //  "sideBarTitle.foreground": "#dddddd",
  //  "activityBar.background": "#080808",
  //  "activityBar.foreground": "#aaaaaa",
  //  "activityBarBadge.background": "#7a2a2a",
  //  "activityBarBadge.foreground": "#ffffff",
  //  "editorGroupHeader.tabsBackground": "#080808",
  //  "editorGroupHeader.tabsBorder": "#080808",
  //  "tab.activeBackground": "#080808",
  //  "tab.activeForeground": "#ffffff",
  //  "tab.inactiveBackground": "#0f0f0f",
  //  "tab.inactiveForeground": "#999999",
  //  "editorLineNumber.foreground": "#4d4d4d",
  //  "editorLineNumber.activeForeground": "#9a9a9a",
  //  "editorCursor.foreground": "#e0e0e0",
  //  "editor.selectionBackground": "#2a2a2a",
  //  "statusBar.background": "#080808",
  //  "statusBar.foreground": "#b0b0b0",
  //  "statusBar.noFolderBackground": "#080808",
  //  "statusBar.debuggingBackground": "#7a2a2a",
  //  "statusBar.border": "#181818",
  //  "titleBar.activeBackground": "#080808",
  //  "titleBar.activeForeground": "#bdbdbd",
  //  "titleBar.inactiveBackground": "#0f0f0f",
  //  "titleBar.inactiveForeground": "#6f6f6f",
  //  "window.activeBorder": "#7a2a2a",
  //  "window.inactiveBorder": "#2a2a2a",
  //},
  "jupyter.interactiveWindow.creationMode": "single",
  "jupyter.interactiveWindow.codeLens.enable": false,
  "redhat.telemetry.enabled": true,
  "chat.viewSessions.orientation": "stacked",
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
  // ======================================================
  // PYTHON — LSP (Pylance / Pyright)
  // ======================================================
  "python.languageServer": "Pylance",
  // Performance and predictability
  "python.analysis.indexing": true,
  "python.analysis.autoImportCompletions": true,
  // Diagnostics (low noise)
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.diagnosticMode": "workspace",
  // Fine-grained warning control
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingImports": "none",
    "reportUnusedImport": "information",
    "reportUnusedVariable": "information",
    "reportGeneralTypeIssues": "warning",
  },
  "python.defaultInterpreterPath": "",
  // Better navigation
  "python.analysis.inlayHints.variableTypes": false,
  "python.analysis.inlayHints.functionReturnTypes": false,
  //"python.analysis.inlayHints.callArgumentNames": false,
  "explorer.confirmDelete": false,
  "editor.stickyScroll.enabled": false,
  "workbench.iconTheme": "material-icon-theme",
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "git.openRepositoryInParentFolders": "always",
  "python.terminal.activateEnvironment": true,
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.stickyScroll.enabled": false,
  "explorer.confirmDragAndDrop": false,
  "workbench.colorTheme": "Tokyo Night",
}
