configuration {
    display-drun: "Apps";
    display-filebrowser: "Files";
    display-run: "Run";
    display-window: "Windows";
    show-icons: true;
    icon-theme: "Papirus";
    font: "GeistMono Nerd Font 10";
    modes: [window, drun, run, filebrowser];
}

* {
    bg:       #080808;
    surface:  #18181B;
    selected: #29292D;
    accent:   #9FBEA0;
    text:     #D7D7DA;
    muted:    #85858B;

    background-color: transparent;
    text-color:       @text;
    border-color:     #48484E;
}

window {
    background-color: @bg;
    border: 1px;
    padding: 10px;
    border-radius: 10px;
    width: 540px;
    location: center;
}

mainbox {
    border: 0;
    padding: 2px;
    spacing: 8px;
    background-color: transparent;
}

inputbar {
    spacing: 8px;
    padding: 9px 10px;
    background-color: @surface;
    text-color: @text;
    border-radius: 8px;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: @accent;
    spacing: 0;
}

entry {
    background-color: transparent;
    text-color: @text;
    placeholder-color: @muted;
}

listview {
    fixed-height: 0;
    border: 0;
    spacing: 4px;
    scrollbar: false;
    padding: 0;
    background-color: transparent;
}

element {
    border: 0;
    padding: 7px 9px;
    background-color: transparent;
    text-color: @text;
    border-radius: 7px;
}

element-icon {
    size: 18px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}

element.normal.normal,
element.alternate.normal,
element.normal.active,
element.alternate.active {
    background-color: transparent;
    text-color: @text;
}

element.normal.urgent,
element.alternate.urgent {
    background-color: transparent;
    text-color: @text;
}

element.selected.normal,
element.selected.active,
element.selected.urgent {
    background-color: @selected;
    text-color: @text;
}

message {
    border: 0;
    padding: 6px;
    background-color: @surface;
    text-color: @text;
    border-radius: 8px;
}

textbox {
    background-color: transparent;
    text-color: @text;
}

scrollbar {
    width: 3px;
    border: 0;
    handle-width: 3px;
    padding: 0;
    background-color: transparent;
    handle-color: @selected;
}
